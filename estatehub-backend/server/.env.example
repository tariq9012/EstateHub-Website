# =====================================================================================
# EstateHub backend — environment variables.
# Copy to `.env` for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables (never commit real values).
# =====================================================================================

NODE_ENV=development
PORT=5000

# ---- MySQL (required) -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=estatehub
DB_USER=root
DB_PASSWORD=
# Hosted MySQL usually requires TLS. Production: DB_SSL=true (and DB_SSL_CA if your provider gives a CA PEM;
# write newlines as \n). Keep DB_SSL_REJECT_UNAUTHORIZED at its default (true) unless your provider says otherwise.
# DB_SSL=true
# DB_SSL_CA=
# DB_SSL_REJECT_UNAUTHORIZED=true
# Pool size PER server instance. Default: 10 locally, 2 on Vercel. Keep (instances x limit) below your DB's max connections.
# DB_CONNECTION_LIMIT=2
# DB_CONNECT_TIMEOUT_MS=10000

# ---- Auth (required) --------------------------------------------------------------
# Production: two DIFFERENT random strings, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Frontend origin / CORS / cookies ---------------------------------------------
# Local: the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173
# Production (Vercel Services, ONE origin for site + API): your final public URL, https, no trailing slash.
# Used for the password-reset links in emails and added to the origin allowlist.
# FRONTEND_URL=https://estatehub-website.vercel.app
# Extra allowed browser origins (comma-separated), e.g. a custom domain next to the vercel.app one.
# CORS_ALLOWED_ORIGINS=
#
# Refresh-token cookie. With one origin (production) the cookie is first-party:
#   Local:       COOKIE_SECURE=false, COOKIE_DOMAIN=localhost, COOKIE_SAMESITE=lax
#   Production:  COOKIE_SECURE=true,  COOKIE_SAMESITE=lax,  COOKIE_DOMAIN NOT SET (host-only = safest)
# Do NOT copy COOKIE_DOMAIN=localhost into Vercel: the server refuses to start with it in production.
COOKIE_SECURE=false
COOKIE_DOMAIN=localhost
COOKIE_SAMESITE=lax
# Reverse-proxy hops to trust for the client IP (rate limiting). Set TRUST_PROXY=1 on Vercel.
# TRUST_PROXY=1

# ---- Email (Gmail SMTP, password reset) -------------------------------------------
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM=EstateHub <your-gmail-address@gmail.com>

# ---- File storage -----------------------------------------------------------------
# local = development (files in ./uploads, unchanged).  r2 = Cloudflare R2 (production / Vercel).
STORAGE_DRIVER=local
# Required only when STORAGE_DRIVER=r2. TWO buckets: R2 can only make a whole bucket public, so private
# verification documents live in a bucket that is never public.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET_NAME=
R2_PRIVATE_BUCKET_NAME=
# Public URL of the PUBLIC bucket (custom domain such as https://media.example.com, or its r2.dev URL). https only.
R2_PUBLIC_BASE_URL=

# ---- Rate limiting across serverless instances (optional but recommended on Vercel) ------
# Upstash Redis REST credentials. Without them each instance counts separately (best-effort limits).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# RATE_LIMIT_FAIL_CLOSED=false

# ---- Optional operator diagnostics ------------------------------------------------
# Lets `GET /api/health/ready?deep=1` with header `x-health-token: <this>` probe both R2 buckets.
# HEALTH_CHECK_TOKEN=
