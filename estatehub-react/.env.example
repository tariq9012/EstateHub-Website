# Copy this file to `.env` (Vite auto-loads it). Restart `npm run dev` after editing.

# Base URL of the EstateHub backend API.
# IMPORTANT: production builds must set this explicitly — without it, the app falls back to
# http://localhost:5000/api (see src/api/apiClient.js), which will not work once deployed.
VITE_API_URL=http://localhost:5000/api
