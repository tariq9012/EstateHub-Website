# Copy this file to `.env` for LOCAL development (Vite auto-loads it). Restart `npm run dev` after editing.

# Base URL of the backend API, INCLUDING the /api suffix, no trailing slash.
#   Local development:  http://localhost:5000/api
#   `vercel dev`:       /api
#   Production (Vercel Services): NOT USED. Production builds ignore this variable and always call the same-origin
#   path /api (see vite.config.js and src/api/apiClient.js). Do not add it to Vercel.
# This is a PUBLIC build-time value (it ends up in the browser bundle). Never put secrets in any VITE_* variable.
VITE_API_URL=http://localhost:5000/api
